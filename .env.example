# Campus Smart Parking Management System Configuration

# Database: Default PostgreSQL connection string (fallback to SQLite if postgres is not running)
DATABASE_URL=postgresql+psycopg2://postgres:postgres@localhost:5432/campus_parking

# Security
SECRET_KEY=campus-parking-production-secret-key-super-secure-389f4b1
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Congestion & Overcrowding Alert Thresholds (%)
OCCUPANCY_WARNING_THRESHOLD=75.0
OCCUPANCY_CRITICAL_THRESHOLD=90.0

# Simulation Mode (Set to true when physical cameras/sensors are offline)
ENABLE_SIMULATION=true
SIMULATION_INTERVAL_SECONDS=8

# Port & Hosts
PORT=8000
HOST=127.0.0.1
